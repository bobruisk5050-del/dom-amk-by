# ==============================================================================
# .htaccess для dom-amk.by (г. Бобруйск)
# Сохранение SEO-позиций и плавные 301 редиректы со старых 100 страниц на лендинг
# ==============================================================================

RewriteEngine On
RewriteBase /

# 1. Принудительный HTTPS (защищенный протокол важен для SEO Google и Яндекса)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. 301-редиректы со старых популярных страниц на соответствующие секции лендинга
# ОСП и листовые материалы
RewriteRule ^osp.*$ /#catalog [R=301,L,NE]
RewriteRule ^osb.*$ /#catalog [R=301,L,NE]
RewriteRule ^plita.*$ /#catalog [R=301,L,NE]

# Кровля, металлочерепица, ондулин
RewriteRule ^krovlya.*$ /#catalog [R=301,L,NE]
RewriteRule ^metallocherepica.*$ /#catalog [R=301,L,NE]
RewriteRule ^ondulin.*$ /#catalog [R=301,L,NE]
RewriteRule ^profnastil.*$ /#catalog [R=301,L,NE]

# Профильная труба и металл
RewriteRule ^truba.*$ /#catalog [R=301,L,NE]
RewriteRule ^profilnaya-truba.*$ /#catalog [R=301,L,NE]

# Фасады АМК и панели
RewriteRule ^amk.*$ /#catalog [R=301,L,NE]
RewriteRule ^fasad.*$ /#catalog [R=301,L,NE]
RewriteRule ^sayding.*$ /#catalog [R=301,L,NE]

# Водосточные системы
RewriteRule ^vodostok.*$ /#catalog [R=301,L,NE]

# Контакты и о компании
RewriteRule ^kontakty.*$ /#contacts [R=301,L,NE]
RewriteRule ^o-kompanii.*$ /#contacts [R=301,L,NE]
RewriteRule ^dostavka.*$ /#delivery [R=301,L,NE]

# 3. Кеширование статики для максимальной скорости (Google PageSpeed 95+)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
